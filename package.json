{
  "name": "streameriux",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:hot": "bun --hot app.tsx",
    "build": "bun build --compile --external web-audio-api app.tsx --outfile dist/streameriux",
    "bundle:mac": "bun scripts/bundle-mac.ts",
    "web:dev": "bun web.ts",
    "screenshot": "bun screenshot.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:tag": "bun scripts/release-tag.ts"
  },
  "dependencies": {
    "@gpuix/react": "^0.7.0",
    "@kud/macos-nowplaying-bridge": "^0.1.0",
    "@mediabunny/server": "^1.56.0",
    "mediabunny": "^1.56.0",
    "react": "^19.2.4",
    "smol-toml": "^1.8.0",
    "web-audio-api": "^1.5.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
